{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege air-gapped ACL for ARES-MedOS Mission Workstation primary window.",
  "windows": [
    "medos-primary"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",

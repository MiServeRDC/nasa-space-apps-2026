{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARESHealthTelemetryPacket",
  "description": "Standardized biometric, environmental, and provenance-tagged telemetry packet transmitted from ares-engine (Safe Rust) to ares-cockpit (React / Three.js) and local MCP agents. Compliant with Issue #4 reproducible BIDMC replay and provenance separation rules.",
  "type": "object",
  "required": [
    "timestamp_ms",
    "relative_recording_time_s",
    "source_record_id",
    "astronaut_id",
    "provenance_manifest",
    "biometrics",
    "safety_margins"
  ],
  "properties": {
    "timestamp_ms": {
      "type": "integer",
      "description": "Replay engine wall-clock tick in milliseconds (distinct from original recording acquisition time; never fabricated as an original clinical timestamp)."
    },
    "relative_recording_time_s": {
      "type": "number",
      "minimum": 0.0,
      "description": "Original relative time in seconds from the start of the recording (e.g. 0 to 480 s for BIDMC numeric CSVs)."
    },
    "source_record_id": {
      "type": "string",
      "description": "Explicit source recording identifier (e.g. 'bidmc_01', 'bidmc_02', 'bidmc_03', or 'SIM-SCENARIO-MARS-184'). Unrelated records are never merged into a fictitious longitudinal patient."
    },
    "mission_elapsed_days": {
      "type": ["number", "null"],
      "description": "Simulated mission elapsed day when running What-If deep-space scenario overlays (null when running pure terrestrial BIDMC replay)."
    },
    "astronaut_id": {
      "type": "string",
      "oneOf": [
        { "enum": ["ASTRO-01", "ASTRO-02", "ASTRO-03", "ASTRO-04"] },
        { "pattern": "^BIDMC-SUBJECT-(0[1-9]|[1-4][0-9]|5[0-3])$" }
      ],
      "description": "Identifier of the monitored crew member or terrestrial replay subject (BIDMC-SUBJECT-01..53)."
    },
    "provenance_manifest": {
      "type": "object",
      "required": ["biometrics_source", "biometrics_native_rate_hz", "ui_refresh_rate_hz", "scenario_overlay_mode"],
      "properties": {
        "biometrics_source": {
          "type": "string",
          "enum": ["RECORDED_TERRESTRIAL_BIDMC_CSV", "RECORDED_TERRESTRIAL_WAVEFORM", "SIMULATED_SCENARIO_INPUT", "HARDWARE_WEARABLE"],
          "description": "Explicit provenance of the primary biometric vitals."
        },
        "biometrics_native_rate_hz": {
          "type": "number",
          "description": "True native sample rate of the underlying biometric source in Hz (e.g. 1.0 Hz for BIDMC Numerics CSV, 125.0 Hz for BIDMC Waveforms)."
        },
        "ui_refresh_rate_hz": {
          "type": "number",
          "description": "Cockpit UI stream tick rate in Hz (e.g. 1.0 Hz or 20.0 Hz; never misrepresents a 1 Hz source as 20 Hz sensor acquisition)."
        },
        "scenario_overlay_mode": {
          "type": "string",
          "enum": ["NONE_PURE_REPLAY", "SIMULATED_WHATIF_SCENARIO"],
          "description": "Indicates whether simulated deep-space scenario inputs (hemodynamics, musculoskeletal, habitat avionics) are active alongside recorded vitals."
        }
      }
    },
    "biometrics": {
      "type": "object",
      "required": ["heart_rate_bpm", "pulse_rate_bpm", "respiration_rate_brpm", "spo2_percent"],
      "properties": {
        "heart_rate_bpm": {
          "type": ["number", "null"],
          "minimum": 20.0,
          "maximum": 240.0,
          "description": "Recorded ECG-derived heart rate in bpm (BIDMC ' HR' column). Null if sensor value is missing/invalid."
        },
        "pulse_rate_bpm": {
          "type": ["number", "null"],
          "minimum": 20.0,
          "maximum": 240.0,
          "description": "Recorded PPG-derived pulse rate in bpm (BIDMC ' PULSE' column; e.g. 13 missing rows in bidmc_01 remain explicitly null/UNAVAILABLE)."
        },
        "respiration_rate_brpm": {
          "type": ["number", "null"],
          "minimum": 2.0,
          "maximum": 60.0,
          "description": "Recorded impedance respiration rate in breaths per minute (BIDMC ' RESP' column). Null if unavailable."
        },
        "spo2_percent": {
          "type": ["number", "null"],
          "minimum": 50.0,
          "maximum": 100.0,
          "description": "Recorded peripheral oxygen saturation percentage (BIDMC ' SpO2' column; e.g. 13 missing rows in bidmc_01 remain explicitly null/UNAVAILABLE)."
        },
        "rr_interval_ms": {
          "type": ["number", "null"],
          "minimum": 250.0,
          "maximum": 2000.0,
          "description": "Beat-to-beat R-R interval in milliseconds. Must be null unless derived from 125 Hz+ ECG waveform R-peaks."
        },
        "hrv_rmssd_ms": {
          "type": ["number", "null"],
          "minimum": 2.0,
          "maximum": 200.0,
          "description": "Root mean square of successive beat-interval differences in ms. Null for 1 Hz numeric-only replay; no HR/respiration proxy. Current Rust baseline serializes this indicator as rmssd_ms; full wire alignment remains issue #8."
        },
        "rmssd_ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unavailable (null) in numeric-only BIDMC replay: beat intervals or appropriate waveform processing are not provided. Current Rust name for hrv_rmssd_ms."
        },
        "sdnn_ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unavailable (null) in numeric-only BIDMC replay: beat intervals or appropriate waveform processing are not provided. Must not be derived from a proxy RMSSD."
        },
        "pnn50_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unavailable (null) in numeric-only BIDMC replay: beat intervals or appropriate waveform processing are not provided. Must not be derived from a proxy RMSSD."
        },
        "lf_hf_ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "Unavailable (null) in numeric-only BIDMC replay: beat intervals or appropriate waveform processing are not provided. Must not be derived from a proxy RMSSD."
        },
        "hrv_unavailable_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "BEAT_INTERVALS_NOT_AVAILABLE",
            null
          ],
          "description": "Why numeric-source HRV is unavailable; separate from sensor dropout. A high numeric SQI does not make beat intervals available."
        },
        "core_temp_celsius": {
          "type": ["number", "null"],
          "minimum": 34.0,
          "maximum": 42.0,
          "description": "Core body temperature in Celsius (null if not present in the recorded source)."
        },
        "missing_channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of channel names that are unavailable/NaN at the current sample tick (e.g. ['pulse_rate_bpm', 'spo2_percent'] in bidmc_01)."
        }
      }
    },
    "hemodynamics": {
      "type": ["object", "null"],
      "description": "Simulated or POCUS-entered jugular hemodynamic state (explicitly tagged with provenance; null in pure BIDMC replay mode).",
      "properties": {
        "provenance": {
          "type": "string",
          "enum": ["SIMULATED_SCENARIO_INPUT", "DERIVED_COMPUTED", "UNAVAILABLE"]
        },
        "ijv_csa_cm2": {
          "type": ["number", "null"],
          "minimum": 0.2,
          "maximum": 6.0,
          "description": "Internal Jugular Vein Cross-Sectional Area in cm^2 (scenario input)."
        },
        "ijv_velocity_max_cm_s": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Peak jugular blood flow velocity in cm/s (scenario input)."
        },
        "wall_shear_stress_dyn_cm2": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 50.0,
          "description": "Derived endothelial wall shear stress tau_w = 2 * mu * v_max * sqrt(pi / IJV_CSA) in dyn/cm^2."
        },
        "pocus_thrombus_confirmed": {
          "type": ["boolean", "null"],
          "description": "Hard Safety Gate 1 input: whether POCUS confirms a non-compressible intraluminal thrombus."
        },
        "thrombosis_risk_score": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Derived Virchow's Triad stasis indicator in [0, 1]."
        }
      }
    },
    "musculoskeletal": {
      "type": ["object", "null"],
      "description": "Simulated What-If musculoskeletal scenario state (null in pure BIDMC replay mode).",
      "properties": {
        "provenance": {
          "type": "string",
          "enum": ["SIMULATED_SCENARIO_INPUT", "DERIVED_COMPUTED", "UNAVAILABLE"]
        },
        "soleus_thickness_mm": {
          "type": ["number", "null"],
          "minimum": 5.0,
          "maximum": 25.0
        },
        "pennation_angle_deg": {
          "type": ["number", "null"],
          "minimum": 8.0,
          "maximum": 35.0
        },
        "bone_resorption_rate_pct": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 5.0
        },
        "mechanotransductive_index": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "environment": {
      "type": ["object", "null"],
      "description": "Simulated habitat environmental avionics state (null in pure BIDMC replay mode).",
      "properties": {
        "provenance": {
          "type": "string",
          "enum": ["SIMULATED_SCENARIO_INPUT", "UNAVAILABLE"]
        },
        "cabin_co2_ppm": {
          "type": ["number", "null"],
          "minimum": 300.0,
          "maximum": 10000.0
        },
        "cabin_o2_kpa": {
          "type": ["number", "null"],
          "minimum": 15.0,
          "maximum": 25.0
        },
        "ambient_radiation_rate_ugy_h": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 50000.0
        },
        "cumulative_radiation_mgy": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 2000.0
        }
      }
    },
    "safety_margins": {
      "type": "object",
      "required": ["provenance", "med_stl_rho_robustness", "mission_readiness_index", "alarm_level"],
      "properties": {
        "provenance": {
          "type": "string",
          "enum": ["DERIVED_FROM_RECORDED_BIDMC", "DERIVED_FROM_HYBRID_SCENARIO"]
        },
        "med_stl_rho_robustness": {
          "type": ["number", "null"],
          "description": "Normalized Quantitative Satisfaction (NQS-STL) degree in (-inf, +1.0] computed over available channels."
        },
        "time_to_violation_days": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Estimated remaining days before critical boundary violation (null when evaluating 8-minute terrestrial BIDMC recordings)."
        },
        "mission_readiness_index": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Composite readiness index (0 to 100)."
        },
        "alarm_level": {
          "type": "string",
          "enum": ["NOMINAL", "ADVISORY", "WARNING", "CRITICAL", "DATA_DEGRADED_MISSING_CHANNELS"],
          "description": "Deterministic alert tier including explicit DATA_DEGRADED_MISSING_CHANNELS when required inputs are null."
        }
      }
    },
    "nqs_stl": {
      "type": "object",
      "description": "Current Rust baseline assessment block. Complete composite and dependent forecasts remain null when HRV is absent or invalid. Full transport reconciliation with safety_margins remains #8.",
      "properties": {
        "ttv_interval_kind": {"type": ["string", "null"], "enum": ["ILLUSTRATIVE_SCENARIO_RANGE", null]},
        "rho_rmssd": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when required valid HRV is unavailable. Available values are illustrative scenario estimates; legacy ci95 field names do not assert calibrated 95% coverage."
        },
        "rho_global": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when required valid HRV is unavailable. Available values are illustrative scenario estimates; legacy ci95 field names do not assert calibrated 95% coverage."
        },
        "ttv_hours": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when required valid HRV is unavailable. Available values are illustrative scenario estimates; legacy ci95 field names do not assert calibrated 95% coverage."
        },
        "ttv_ci95_low_hours": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when required valid HRV is unavailable. Available values are illustrative scenario estimates; legacy ci95 field names do not assert calibrated 95% coverage."
        },
        "ttv_ci95_high_hours": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when required valid HRV is unavailable. Available values are illustrative scenario estimates; legacy ci95 field names do not assert calibrated 95% coverage."
        },
        "mri_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when required valid HRV is unavailable. Available values are illustrative scenario estimates; legacy ci95 field names do not assert calibrated 95% coverage."
        }
      }
    },
    "alert_severity": {
      "type": "string",
      "enum": [
        "NOMINAL",
        "DATA_DEGRADED_MISSING_CHANNELS",
        "CAUTION",
        "WARNING",
        "CRITICAL_EMERGENCY"
      ],
      "description": "Current Rust baseline severity: missing HRV produces degraded assessment unless a known hazard requires warning/emergency. Other baseline wire differences remain #8."
    },
    "model_validation_status": {
      "type": "string",
      "enum": [
        "ILLUSTRATIVE_UNVALIDATED"
      ],
      "description": "Current model outputs are illustrative and lack clinical/outcome calibration. Separate from recorded-data provenance. Accepted numerical gates do not imply calibrated coverage."
    },
    "active_playbook": {
      "type": ["object", "null"],
      "properties": {
        "playbook_id": {
          "type": "string"
        },
        "current_step": {
          "type": "integer"
        },
        "total_steps": {
          "type": "integer"
        },
        "step_instruction": {
          "type": "string"
        }
      }
    },
    "vitals_anomaly": {
      "type": ["object", "null"],
      "description": "Per-subject anomaly detector output on the recorded vitals (DERIVED_COMPUTED). Thresholds are nominal; measured recall and alert rates are in docs/evaluation/ANOMALY_DETECTOR_EVAL.md.",
      "required": ["baseline_ready", "overall", "channels"],
      "properties": {
        "recording_time_s": { "type": "number" },
        "baseline_ready": { "type": "boolean" },
        "baseline_samples": { "type": "integer" },
        "baseline_required": { "type": "integer" },
        "overall": {
          "type": "string",
          "enum": ["NORMAL", "ATTENTION", "ALARM"]
        },
        "mahalanobis_d2": { "type": ["number", "null"] },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "status", "evaluable", "reason"],
            "properties": {
              "channel": { "type": "string" },
              "status": { "type": "string", "enum": ["NORMAL", "ATTENTION", "ALARM"] },
              "evaluable": { "type": "boolean" },
              "detector": {
                "type": ["string", "null"],
                "enum": ["ROBUST_Z_SCORE", "CUSUM_DRIFT", "MAHALANOBIS", "SENSOR_DROPOUT", null]
              },
              "value": { "type": ["number", "null"] },
              "baseline_median": { "type": ["number", "null"] },
              "baseline_sigma": { "type": ["number", "null"] },
              "z_score": { "type": ["number", "null"] },
              "duration_s": { "type": "number" },
              "reason": { "type": "string" }
            }
          }
        },
        "injection": {
          "type": ["object", "null"],
          "properties": {
            "kind": { "type": "string" },
            "description": { "type": "string" },
            "onset_s": { "type": "number" },
            "elapsed_s": { "type": "number" },
            "duration_s": { "type": "number" }
          }
        }
      }
    },
    "aerospace_360": {
      "$ref": "#/$defs/AerospaceMedical360State"
    }
  },
  "$defs": {
    "PlaybookId": {
      "type": "string",
      "enum": [
        "PLAYBOOK_01_VENOUS_STASIS_LBNP",
        "PLAYBOOK_02_CONFIRMED_IJV_THROMBUS",
        "PLAYBOOK_03_SARCOPENIA_OSTEOPENIA_ARED",
        "PLAYBOOK_04_SANS_TRANSLAMINAR_MITIGATION",
        "PLAYBOOK_05_SPE_RADIATION_SHELTER_CANS",
        "PLAYBOOK_06_HYPOXEMIA_DESATURATION",
        "PLAYBOOK_07_HEART_RATE_ANOMALY",
        "PLAYBOOK_08_SENSOR_SIGNAL_LOSS",
        "PLAYBOOK_09_MULTIPARAMETER_DETERIORATION",
        "PLAYBOOK_10_RENAL_LITHIASIS",
        "PLAYBOOK_11_MARS_ENTRY_FLUID_LOADING",
        "PLAYBOOK_12_CIRCADIAN_LIGHT_HYGIENE",
        "PLAYBOOK_13_VIRAL_IMMUNE_VALACYCLOVIR",
        "PLAYBOOK_14_CO2_SCRUBBER_SANS",
        "PLAYBOOK_15_EFAST_TRAUMA_TRIAGE",
        "PLAYBOOK_16_SEPSIS_SEPTIC_SHOCK",
        "PLAYBOOK_17_HEMORRHAGIC_TRAUMA_TXA",
        "PLAYBOOK_18_TORSO_SHOCK_PERICARDIOCENTESIS",
        "PLAYBOOK_19_CONSERVATIVE_ACUTE_ABDOMEN_0G",
        "PLAYBOOK_20_EVA_MUSCULOSKELETAL_SPINE_FRACTURE",
        "PLAYBOOK_21_DENTAL_MAXILLOFACIAL_EMERGENCY",
        "PLAYBOOK_22_OCULAR_FOREIGN_BODY_CHEMICAL_BURN",
        "PLAYBOOK_23_ANAPHYLAXIS_AIRWAY_EMERGENCY",
        "PLAYBOOK_24_MICROGRAVITY_CARDIAC_ARREST_CPR",
        "PLAYBOOK_25_ACUTE_URINARY_RETENTION_POCUS",
        "PLAYBOOK_26_ACUTE_RADIATION_SYNDROME",
        "PLAYBOOK_27_AEROSPACE_TOXICOLOGY_EXPOSURE",
        "PLAYBOOK_28_EVA_DCS_AND_SUIT_EMERGENCY",
        "PLAYBOOK_29_BMED_PSYCHIATRIC_CRISIS",
        "PLAYBOOK_30_FEMALE_PELVIC_UROGYN_POCUS"
      ],
      "description": "Deterministic MedOps Playbook identifiers (#01..=#30) synchronized with binary_ipc.rs and binaryTelemetryDecoder.ts."
    },
    "ModelValidationStatus": {
      "type": "string",
      "enum": [
        "ILLUSTRATIVE_UNVALIDATED",
        "INTERNALLY_BENCHMARKED_TERRESTRIAL",
        "CLINICALLY_CALIBRATED_SUBJECT_TO_REVIEW"
      ]
    },
    "BiologicalSex": {
      "type": "string",
      "enum": ["Male", "Female"]
    },
    "ContraceptiveRegimen": {
      "type": "string",
      "enum": [
        "None",
        "CombinedEthinylestradiolCoc",
        "ProgestinOnlyOral",
        "LevonorgestrelIud",
        "SubdermalImplant"
      ]
    },
    "CrewBiologicalProfile": {
      "type": "object",
      "properties": {
        "biological_sex": { "$ref": "#/$defs/BiologicalSex" },
        "age_years": { "type": "number" },
        "body_mass_kg": { "type": "number" },
        "height_cm": { "type": "number" },
        "baseline_hematocrit_pct": { "type": ["number", "null"] },
        "baseline_hemoglobin_g_dl": { "type": ["number", "null"] },
        "contraceptive_regimen": { "$ref": "#/$defs/ContraceptiveRegimen" },
        "drug_allergies": { "type": "array", "items": { "type": "string" } },
        "g6pd_deficient": { "type": "boolean" },
        "baseline_qtc_ms": { "type": ["number", "null"] }
      }
    },
    "LbnpBaselineState": {
      "type": "object",
      "properties": {
        "pre_lbnp_sbp_baseline_mmhg": { "type": "number" },
        "pre_lbnp_hr_baseline_bpm": { "type": "number" },
        "captured_at_timestamp_ms": { "type": "integer" }
      }
    },
    "EclssCoupledSummary": {
      "type": "object",
      "properties": {
        "max_ppco2_mmhg": { "type": "number" },
        "cabin_ppco2_mmhg": { "type": ["number", "null"] },
        "helmet_ppco2_mmhg": { "type": ["number", "null"] },
        "affected_crew_count": { "type": "integer", "minimum": 0 },
        "root_cause_label": { "type": "string" },
        "scrubber_override_active": { "type": "boolean" },
        "emergency_pba_o2_mask_required": { "type": "boolean" },
        "validation_status": { "$ref": "#/$defs/ModelValidationStatus" }
      }
    },
    "RadiationArsState": {
      "type": "object",
      "properties": {
        "cumulative_mission_dose_msv": { "type": "number" },
        "estimated_acute_bfo_dose_gy": { "type": "number" },
        "predicted_anc_k_ul": { "type": "number" },
        "predicted_plt_k_ul": { "type": "number" },
        "severe_neutropenia": { "type": "boolean" },
        "febrile_neutropenia_emergency": { "type": "boolean" },
        "filgrastim_indicated": { "type": "boolean" },
        "sex_age_reid_multiplier": { "type": "number" },
        "days_post_spe": { "type": "number" },
        "validation_status": { "$ref": "#/$defs/ModelValidationStatus" }
      }
    },
    "AcuteEmergencyState": {
      "type": "object",
      "properties": {
        "shock_index": { "type": ["number", "null"] },
        "pulseless_cardiac_arrest": { "type": "boolean" },
        "anaphylaxis_suspected": { "type": "boolean" },
        "active_arterial_hemorrhage": { "type": "boolean" },
        "injury_hours_elapsed": { "type": ["number", "null"] },
        "acute_abdomen_nom_suspected": { "type": "boolean" },
        "dental_ludwigs_angina_threat": { "type": "boolean" },
        "ocular_chemical_or_fb_injury": { "type": "boolean" },
        "seidel_perforation_positive": { "type": "boolean" },
        "eva_musculoskeletal_trauma": { "type": "boolean" },
        "acute_urinary_retention_ml": { "type": ["number", "null"] },
        "pelvic_emergency_flag": { "type": "boolean" },
        "active_acute_playbook_code": { "type": ["integer", "null"], "minimum": 16, "maximum": 30 },
        "validation_status": { "$ref": "#/$defs/ModelValidationStatus" }
      }
    },
    "ToxicologyDcsState": {
      "type": "object",
      "properties": {
        "nh3_ppm": { "type": "number" },
        "mmh_ppm": { "type": "number" },
        "no2_ppm": { "type": "number" },
        "co_ppm": { "type": "number" },
        "hcn_ppm": { "type": "number" },
        "hcl_ppm": { "type": "number" },
        "methemoglobin_pct": { "type": "number" },
        "perchlorate_exposure_mg_kg_d": { "type": "number" },
        "nis_thyroid_uptake_fraction": { "type": "number" },
        "haldane_tissue_ratio_r360": { "type": "number" },
        "spencer_vge_grade": { "type": "integer", "minimum": 0, "maximum": 4 },
        "helmet_water_intrusion_detected": { "type": "boolean" },
        "lcvg_pump_fault": { "type": "boolean" },
        "eva_prebreathe_locked": { "type": "boolean" },
        "dcs_type2_or_age_active": { "type": "boolean" },
        "validation_status": { "$ref": "#/$defs/ModelValidationStatus" }
      }
    },
    "PharmacologySepsisState": {
      "type": "object",
      "properties": {
        "qsofa_score": { "type": "integer", "minimum": 0, "maximum": 3 },
        "suspected_infection": { "type": "boolean" },
        "sepsis_protocol_active": { "type": "boolean" },
        "septic_shock_active": { "type": "boolean" },
        "recommended_crystalloid_bolus_ml": { "type": "number" },
        "effective_qtc_ms": { "type": "number" },
        "estimated_egfr_ml_min": { "type": ["number", "null"] },
        "lowest_formulary_potency_pct": { "type": "number" },
        "depleted_or_subpotent_drugs": { "type": "array", "items": { "type": "string" } },
        "validation_status": { "$ref": "#/$defs/ModelValidationStatus" }
      }
    },
    "BMedTriageClass": {
      "type": "string",
      "enum": [
        "Nominal",
        "MildAdjustmentOrFatigue",
        "ModerateDepressionOrAnxiety",
        "SecondaryOrganicToxicMetabolicDelirium",
        "PrimaryAcutePsychiatricCrisis",
        "ImminentSelfOrVehicleHarmCrisis"
      ]
    },
    "BehavioralHealthState": {
      "type": "object",
      "properties": {
        "phq9_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 27 },
        "gad7_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 21 },
        "cssrs_suicidal_ideation_level": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "acute_agitation_or_psychosis": { "type": "boolean" },
        "imminent_harm_to_self_or_vehicle": { "type": "boolean" },
        "organic_delirium_mimic_detected": { "type": "boolean" },
        "triage_classification": { "$ref": "#/$defs/BMedTriageClass" },
        "airlock_software_lockout_active": { "type": "boolean" },
        "cmrs_restraint_authorized": { "type": "boolean" },
        "validation_status": { "$ref": "#/$defs/ModelValidationStatus" }
      }
    },
    "ExtendedSafetyGates": {
      "type": "object",
      "properties": {
        "gate5_nsaid_renal_bleeding_locked": { "type": "boolean" },
        "gate5_allergy_or_qtc_locked": { "type": "boolean" },
        "gate5_formulary_substitution_active": { "type": "boolean" },
        "gate6_radiation_neutropenic_invasive_locked": { "type": "boolean" },
        "gate7_bmed_delirium_or_restraint_guard_active": { "type": "boolean" }
      }
    },
    "AerospaceMedical360State": {
      "type": ["object", "null"],
      "description": "Optional 360-degree aerospace medical envelope covering sex-specific physiology, LBNP baseline, ECLSS CO2 coupling, SPE/ARS radiation, acute 0g emergencies, toxicology/DCS, space pharmacology/sepsis, behavioral health, and extended safety gates (Gates 5-7).",
      "properties": {
        "crew_profile": { "$ref": "#/$defs/CrewBiologicalProfile" },
        "lbnp_baseline": { "oneOf": [{ "$ref": "#/$defs/LbnpBaselineState" }, { "type": "null" }] },
        "eclss_coupled": { "oneOf": [{ "$ref": "#/$defs/EclssCoupledSummary" }, { "type": "null" }] },
        "radiation_ars": { "oneOf": [{ "$ref": "#/$defs/RadiationArsState" }, { "type": "null" }] },
        "acute_emergency": { "oneOf": [{ "$ref": "#/$defs/AcuteEmergencyState" }, { "type": "null" }] },
        "toxicology_dcs": { "oneOf": [{ "$ref": "#/$defs/ToxicologyDcsState" }, { "type": "null" }] },
        "pharmacology_sepsis": { "oneOf": [{ "$ref": "#/$defs/PharmacologySepsisState" }, { "type": "null" }] },
        "behavioral_health": { "oneOf": [{ "$ref": "#/$defs/BehavioralHealthState" }, { "type": "null" }] },
        "extended_safety_gates": { "$ref": "#/$defs/ExtendedSafetyGates" }
      }
    }
  }
}

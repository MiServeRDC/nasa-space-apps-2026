# Leave both unset for the standalone or hosted same-origin release.
# npm run dev proxies /api and /ws to the local engine on port 8080.
# Only set these for an intentional separate-origin API-only deployment.
# VITE_ARES_HTTP_URL=http://127.0.0.1:8080
# VITE_ARES_WS_URL=ws://127.0.0.1:8080/ws/telemetry
